# Base URL of the MELA DESK backend API (server-side usage)
BACKEND_API_URL=http://localhost:4000/api

# Base URL used by browser-facing API client (must NOT contain secrets)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Development-only: serve the frontend with in-repo clearly-labeled mock data.
# NEVER enable in production.
NEXT_PUBLIC_USE_MOCKS=false

# Mock dev credentials (development only)
NEXT_PUBLIC_MOCK_EMAIL=requester@meladesk.test
NEXT_PUBLIC_MOCK_PASSWORD=Password123!

# Local Docker Compose database/API settings. Use unique random values outside local development.
MYSQL_DATABASE=meladesk
MYSQL_USER=meladesk
MYSQL_PASSWORD=replace-with-a-url-safe-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-random-local-root-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
DEV_SEED_PASSWORD=Password123!
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
