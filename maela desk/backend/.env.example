# Use a dedicated local development database. Never put production credentials here.
DATABASE_URL="mysql://meladesk:replace-with-a-local-password@127.0.0.1:3306/meladesk?connection_limit=10"

NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=mela_session
CSRF_COOKIE_NAME=mela_csrf
SESSION_TTL_HOURS=12
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRUST_PROXY=false

UPLOAD_DIR=./var/private-uploads
MAX_UPLOAD_BYTES=10485760
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
HOUSEKEEPING_INTERVAL_MS=86400000

# Optional SMTP. Password-reset and notification outbox jobs remain queued until configured.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MELA DESK <no-reply@localhost>"
PUBLIC_APP_URL=http://localhost:3000

# Development-only deterministic seed accounts. Do not use or expose in production.
DEV_SEED_PASSWORD=Password123!
